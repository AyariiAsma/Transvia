// This is your Prisma schema file for LogisticApp
// Using PostgreSQL with PostGIS extension

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  CHAUFFEUR
  ADMIN
}

enum AdminSubRole {
  SUPER_ADMIN
  SUPPORT
  FINANCE
}

enum DriverStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum DocumentType {
  LICENSE
  REGISTRATION
  INSURANCE
  NATIONAL_ID
  PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum RideStatus {
  CREATED
  SEARCHING
  ACCEPTED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  RIDE_STARTED
  COMPLETED
  PAYMENT_CONFIRMED
  CANCELLED
  NO_DRIVER
  DISPUTED
}

enum ServiceType {
  RIDE
  DELIVERY
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  PAYOUT
  TOPUP
  COMMISSION
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  RIDE_REQUEST
  RIDE_ACCEPTED
  RIDE_CANCELLED
  RIDE_COMPLETED
  DRIVER_ARRIVED
  PAYMENT
  PROMO
  SYSTEM
  SOS
  DOCUMENT_STATUS
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketType {
  DISPUTE
  REPORT
  GENERAL
  PAYMENT
}

enum PromoType {
  PERCENTAGE
  FIXED
}

enum Platform {
  IOS
  ANDROID
}

enum Language {
  fr
  ar
  en
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone            String    @unique
  email            String?   @unique
  passwordHash     String?   @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  avatarUrl        String?   @map("avatar_url")
  role             UserRole  @default(CLIENT)
  countryCode      String    @map("country_code") // +216, +213, +212
  language         Language  @default(fr)
  isVerifiedPhone  Boolean   @default(false) @map("is_verified_phone")
  isVerifiedEmail  Boolean   @default(false) @map("is_verified_email")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at") // Soft delete (RGPD)

  // Relations
  driver           Driver?
  clientProfile    ClientProfile?
  adminRole        AdminRole?
  devices          Device[]
  notifications    Notification[]
  ridesAsClient    Ride[]           @relation("ClientRides")
  ratingsGiven     Rating[]         @relation("RaterRatings")
  ratingsReceived  Rating[]         @relation("RateeRatings")
  wallet           Wallet?
  supportTickets   SupportTicket[]  @relation("UserTickets")
  auditLogs        AuditLog[]       @relation("UserAuditLogs")
  refreshTokens    RefreshToken[]

  @@index([phone, countryCode])
  @@index([email])
  @@index([role])
  @@index([isActive, deletedAt])
  @@map("users")
}

model ClientProfile {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  homeAddress     Json?    @map("home_address")  // {formatted, lat, lng, placeId}
  workAddress     Json?    @map("work_address")
  favoriteLocations Json[] @map("favorite_locations") @default([])
  ratingAvg       Float    @default(0) @map("rating_avg")
  totalRides      Int      @default(0) @map("total_rides")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Driver {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  licenseNumber  String       @map("license_number")
  licenseExpiry  DateTime     @map("license_expiry")
  status         DriverStatus @default(PENDING)
  ratingAvg      Float        @default(0) @map("rating_avg")
  totalRides     Int          @default(0) @map("total_rides")
  isOnline       Boolean      @default(false) @map("is_online")
  currentLat     Float?       @map("current_lat")
  currentLng     Float?       @map("current_lng")
  lastSeenAt     DateTime?    @map("last_seen_at")
  earningsTotal  Decimal      @default(0) @db.Decimal(12, 3) @map("earnings_total")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents DriverDocument[]
  vehicle   Vehicle?
  ridesAsDriver Ride[]       @relation("DriverRides")
  payouts   Payout[]

  @@index([isOnline, status])
  @@index([status])
  @@map("drivers")
}

model DriverDocument {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId         String         @map("driver_id") @db.Uuid
  type             DocumentType
  cloudinaryUrl    String         @map("cloudinary_url")
  cloudinaryPublicId String?      @map("cloudinary_public_id")
  status           DocumentStatus @default(PENDING)
  expiresAt        DateTime?      @map("expires_at")
  rejectionReason  String?        @map("rejection_reason")
  verifiedBy       String?        @map("verified_by") @db.Uuid
  verifiedAt       DateTime?      @map("verified_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
  @@index([driverId, status])
  @@map("driver_documents")
}

model Vehicle {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId     String   @unique @map("driver_id") @db.Uuid
  typeId       String   @map("type_id") @db.Uuid
  make         String
  model        String
  year         Int
  plateNumber  String   @map("plate_number")
  color        String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @relation(fields: [typeId], references: [id])

  @@index([typeId])
  @@map("vehicles")
}

model VehicleType {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String
  iconUrl        String?     @map("icon_url")
  baseFare       Decimal     @db.Decimal(10, 3) @map("base_fare")
  perKmRate      Decimal     @db.Decimal(10, 3) @map("per_km_rate")
  perMinuteRate  Decimal     @db.Decimal(10, 3) @map("per_minute_rate")
  minFare        Decimal     @db.Decimal(10, 3) @map("min_fare")
  maxPassengers  Int         @default(4) @map("max_passengers")
  serviceType    ServiceType @default(RIDE) @map("service_type")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  vehicles      Vehicle[]
  rides         Ride[]
  pricingRules  PricingRule[]
  promoCodes    PromoCodeVehicleType[]

  @@map("vehicle_types")
}

model Ride {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  driverId        String?       @map("driver_id") @db.Uuid
  vehicleTypeId   String        @map("vehicle_type_id") @db.Uuid
  serviceType     ServiceType   @default(RIDE) @map("service_type")
  status          RideStatus    @default(CREATED)

  // Pickup
  pickupLat       Float         @map("pickup_lat")
  pickupLng       Float         @map("pickup_lng")
  pickupAddress   String        @map("pickup_address")

  // Dropoff
  dropoffLat      Float         @map("dropoff_lat")
  dropoffLng      Float         @map("dropoff_lng")
  dropoffAddress  String        @map("dropoff_address")

  // Route
  routePolyline   String?       @map("route_polyline")
  distanceKm      Float?        @map("distance_km")
  durationMinutes Float?        @map("duration_minutes")

  // Fare
  estimatedFare   Decimal?      @db.Decimal(12, 3) @map("estimated_fare")
  finalFare       Decimal?      @db.Decimal(12, 3) @map("final_fare")
  surgeMultiplier Decimal       @default(1) @db.Decimal(4, 2) @map("surge_multiplier")
  promoCodeId     String?       @map("promo_code_id") @db.Uuid
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")

  // Cancellation
  cancelledBy     String?       @map("cancelled_by") @db.Uuid
  cancelReason    String?       @map("cancel_reason")
  cancellationFee Decimal?      @db.Decimal(10, 3) @map("cancellation_fee")

  // Locale
  currencyCode    String        @default("TND") @map("currency_code")
  countryCode     String        @map("country_code")

  // Notes
  clientNotes     String?       @map("client_notes")

  // Timestamps
  scheduledAt     DateTime?     @map("scheduled_at")
  requestedAt     DateTime      @default(now()) @map("requested_at")
  acceptedAt      DateTime?     @map("accepted_at")
  arrivedAt       DateTime?     @map("arrived_at")
  startedAt       DateTime?     @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  cancelledAt     DateTime?     @map("cancelled_at")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  client          User          @relation("ClientRides", fields: [clientId], references: [id])
  driver          Driver?       @relation("DriverRides", fields: [driverId], references: [id])
  vehicleType     VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id])
  payment         Payment?
  statusHistory   RideStatusHistory[]
  locations       RideLocation[]
  ratings         Rating[]
  supportTickets  SupportTicket[]

  @@index([clientId, requestedAt(sort: Desc)])
  @@index([driverId, requestedAt(sort: Desc)])
  @@index([status])
  @@index([requestedAt(sort: Desc)])
  @@index([countryCode, status])
  @@map("rides")
}

model RideStatusHistory {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rideId     String     @map("ride_id") @db.Uuid
  status     RideStatus
  changedBy  String?    @map("changed_by") @db.Uuid
  metadata   Json?
  changedAt  DateTime   @default(now()) @map("changed_at")

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, changedAt(sort: Desc)])
  @@map("ride_status_history")
}

model RideLocation {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rideId      String   @map("ride_id") @db.Uuid
  lat         Float
  lng         Float
  heading     Float?
  speed       Float?
  recordedAt  DateTime @default(now()) @map("recorded_at")

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, recordedAt(sort: Desc)])
  @@map("ride_locations")
}

model Payment {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rideId                String        @unique @map("ride_id") @db.Uuid
  payerId               String        @map("payer_id") @db.Uuid
  payeeId               String        @map("payee_id") @db.Uuid
  amount                Decimal       @db.Decimal(12, 3)
  currency              String
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeChargeId        String?       @map("stripe_charge_id")
  idempotencyKey        String        @unique @map("idempotency_key")
  platformCommission    Decimal       @db.Decimal(12, 3) @map("platform_commission")
  driverEarnings        Decimal       @db.Decimal(12, 3) @map("driver_earnings")
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([payerId, createdAt(sort: Desc)])
  @@index([payeeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("payments")
}

model Wallet {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(12, 3)
  currency  String   @default("TND")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletId    String          @map("wallet_id") @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 3)
  balanceAfter Decimal        @db.Decimal(12, 3) @map("balance_after")
  description String
  referenceId String?         @map("reference_id")
  metadata    Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@map("transactions")
}

model Payout {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId    String       @map("driver_id") @db.Uuid
  amount      Decimal      @db.Decimal(12, 3)
  currency    String
  status      PayoutStatus @default(PENDING)
  notes       String?
  processedBy String?      @map("processed_by") @db.Uuid
  requestedAt DateTime     @default(now()) @map("requested_at")
  processedAt DateTime?    @map("processed_at")

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, requestedAt(sort: Desc)])
  @@index([status])
  @@map("payouts")
}

model PromoCode {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code             String    @unique
  type             PromoType
  value            Decimal   @db.Decimal(10, 3)
  minFare          Decimal?  @db.Decimal(10, 3) @map("min_fare")
  maxDiscount      Decimal?  @db.Decimal(10, 3) @map("max_discount")
  currency         String?
  usageLimit       Int?      @map("usage_limit")
  usedCount        Int       @default(0) @map("used_count")
  userLimitPerCode Int       @default(1) @map("user_limit_per_code")
  validFrom        DateTime  @map("valid_from")
  validUntil       DateTime? @map("valid_until")
  countryCodes     String[]  @map("country_codes")
  isActive         Boolean   @default(true) @map("is_active")
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  vehicleTypes PromoCodeVehicleType[]
  rides        Ride[]

  @@index([code, isActive])
  @@map("promo_codes")
}

model PromoCodeVehicleType {
  promoCodeId   String @map("promo_code_id") @db.Uuid
  vehicleTypeId String @map("vehicle_type_id") @db.Uuid

  promoCode   PromoCode   @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@id([promoCodeId, vehicleTypeId])
  @@map("promo_code_vehicle_types")
}

model PricingRule {
  id                     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  vehicleTypeId          String    @map("vehicle_type_id") @db.Uuid
  countryCode            String    @map("country_code")
  zoneId                 String?   @map("zone_id") @db.Uuid
  baseFare               Decimal   @db.Decimal(10, 3) @map("base_fare")
  perKmRate              Decimal   @db.Decimal(10, 3) @map("per_km_rate")
  perMinuteRate          Decimal   @db.Decimal(10, 3) @map("per_minute_rate")
  minFare                Decimal   @db.Decimal(10, 3) @map("min_fare")
  platformCommissionPct  Decimal   @db.Decimal(4, 3) @map("platform_commission_pct")
  surgeEnabled           Boolean   @default(false) @map("surge_enabled")
  surgeMultiplierMax     Decimal   @default(2) @db.Decimal(4, 2) @map("surge_multiplier_max")
  cancellationFee        Decimal   @default(0) @db.Decimal(10, 3) @map("cancellation_fee")
  cancellationGraceMinutes Int     @default(3) @map("cancellation_grace_minutes")
  effectiveFrom          DateTime  @map("effective_from")
  effectiveTo            DateTime? @map("effective_to")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  zone        Zone?       @relation(fields: [zoneId], references: [id])

  @@index([vehicleTypeId, countryCode, isActive])
  @@map("pricing_rules")
}

model Zone {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  countryCode     String   @map("country_code")
  // boundary stocké comme GeoJSON JSON (PostGIS via raw query pour les recherches)
  boundary        Json
  isActive        Boolean  @default(true) @map("is_active")
  surgeActive     Boolean  @default(false) @map("surge_active")
  surgeMultiplier Decimal  @default(1) @db.Decimal(4, 2) @map("surge_multiplier")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  pricingRules PricingRule[]

  @@index([countryCode, isActive])
  @@map("zones")
}

model Rating {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rideId    String   @map("ride_id") @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  score     Int      // 1-5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  ride  Ride @relation(fields: [rideId], references: [id])
  rater User @relation("RaterRatings", fields: [raterId], references: [id])
  ratee User @relation("RateeRatings", fields: [rateeId], references: [id])

  @@unique([rideId, raterId])
  @@index([rateeId, score])
  @@map("ratings")
}

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  sentVia   String           @default("BOTH") @map("sent_via") // PUSH | SOCKET | BOTH
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model Device {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fcmToken    String   @map("fcm_token")
  platform    Platform
  deviceId    String   @map("device_id")
  appVersion  String   @map("app_version")
  isActive    Boolean  @default(true) @map("is_active")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@map("devices")
}

model SupportTicket {
  id          String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  rideId      String?             @map("ride_id") @db.Uuid
  type        SupportTicketType
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  priority    String              @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedTo  String?             @map("assigned_to") @db.Uuid
  resolvedAt  DateTime?           @map("resolved_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user User  @relation("UserTickets", fields: [userId], references: [id])
  ride Ride? @relation(fields: [rideId], references: [id])

  @@index([status, priority, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("support_tickets")
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   // e.g. "RIDE_CANCELLED", "DRIVER_APPROVED"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model AdminRole {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  subRole      AdminSubRole @map("sub_role")
  permissions  Json         @default("{}") // { "rides": true, "finance": false, ... }
  countryScope String[]     @map("country_scope") // [] = all countries
  createdBy    String?      @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_roles")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  deviceId  String?  @map("device_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Setting {
  key         String   @id
  value       Json
  description String?
  category    String   @default("general")
  countryCode String?  @map("country_code") // null = global
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, countryCode])
  @@map("settings")
}
